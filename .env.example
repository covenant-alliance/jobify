# Copy to .env (git-ignored) and fill in. Nothing here has a safe default for production.

# --- required ---
# openssl rand -base64 32
JWT_SECRET=
POSTGRES_PASSWORD=

# --- database (defaults shown) ---
POSTGRES_DB=jobify
POSTGRES_USER=jobify

# --- first administrator (only used while the database has no admin; empty = skip) ---
# The password must satisfy the password policy (8+ characters, not common, not the username).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- deployment ---
# Comma-separated list of front-end origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# true ONLY behind a reverse proxy you control that overwrites X-Forwarded-For (the login rate limit uses it).
TRUST_FORWARDED_FOR=false
# true exposes Swagger UI and /v3/api-docs publicly. Keep false in production.
APP_DOCS_ENABLED=false
# JSON log format: logstash, ecs or gelf.
LOG_FORMAT=logstash
APP_PORT=9080
