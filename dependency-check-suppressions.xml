<?xml version="1.0" encoding="UTF-8"?>
<!--
  Findings of the OWASP dependency-check scan (mvn -Psecurity-scan verify) that were judged and are knowingly left.
  RULES (docs/DEPENDENCY_SCAN.md, "Response policy"):
    * every <suppress> has an `until` date at most 12 months ahead, so it is looked at again (an expired entry makes the finding reappear)
    * every <suppress> has <notes>: the reason, who decided, the date, and a link to the discussion
    * a change to this file needs the Product Owner's review
  An empty file is correct: it means nothing has been suppressed.

  Template:
  <suppress until="2027-01-01Z">
    <notes>REASON. Decided by NAME on YYYY-MM-DD, see #ISSUE.</notes>
    <packageUrl regex="true">^pkg:maven/GROUP/ARTIFACT@.*$</packageUrl>
    <cve>CVE-XXXX-NNNN</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!-- Swagger UI's bundled DOMPurify (3.4.15) is affected; the fix, DOMPurify 3.4.16, is not yet in any swagger-ui webjar (5.32.14 is the latest). -->
  <suppress until="2027-01-15Z">
    <notes>Low severity (RetireJS, unscored). The code is Swagger UI's browser bundle, served only on the dev profile; Swagger is switched off on the postgres (production) profile, so no user content reaches it in production. Proposed by Claude from the 2026-10-15 baseline scan, to be confirmed by the Product Owner, see #81. Remove when a swagger-ui webjar bundling DOMPurify 3.4.16 or later is out.</notes>
    <filePath regex="true">.*/swagger-ui-[\d.]+\.jar/META-INF/resources/webjars/swagger-ui/.*</filePath>
    <cve>CVE-2026-109344</cve>
    <cve>CVE-2026-109345</cve>
  </suppress>
</suppressions>
